{id:"api-2014-ability-scores-str",name:"Strength",content:[{id:"Title",content:"Strength"},{id:"TitledText",content:[{title:"",content:"Strength measures bodily power, athletic training, and the extent to which you can exert raw physical force."},{title:"",content:"A Strength check can model any attempt to lift, push, pull, or break something, to force your body through a space, or to otherwise apply brute force to a situation. The Athletics skill reflects aptitude in certain kinds of Strength checks."}]},{id:"LinkList",content:[{id:"@api-2014-skills-athletics",content:""}]}]}