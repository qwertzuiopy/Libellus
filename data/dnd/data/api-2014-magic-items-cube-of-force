{id:"api-2014-magic-items-cube-of-force",name:"Cube of Force",content:[{id:"Title",content:"Cube of Force"},{id:"StatGrid",content:[{title:"Category",content:"Wondrous Items"},{title:"Rarity",content:"Rare"}]},{id:"TitledText",content:[{title:"",content:"Wondrous item, rare (requires attunement)"},{title:"",content:"This cube is about an inch across. Each face has a distinct marking on it that can be pressed. The cube starts with 36 charges, and it regains 1d20 expended charges daily at dawn."},{title:"",content:"You can use an action to press one of the cube's faces, expending a number of charges based on the chosen face, as shown in the Cube of Force Faces table. Each face has a different effect. If the cube has insufficient charges remaining, nothing happens. Otherwise, a barrier of invisible force springs into existence, forming a cube 15 feet on a side. The barrier is centered on you, moves with you, and lasts for 1 minute, until you use an action to press the cube's sixth face, or the cube runs out of charges. You can change the barrier's effect by pressing a different face of the cube and expending the requisite number of charges, resetting the duration."},{title:"",content:"If your movement causes the barrier to come into contact with a solid object that can't pass through the cube, you can't move any closer to that object as long as the barrier remains."},{title:"",content:"Cube of Force Faces"},{title:"",content:"| Face | Charges | Effect |"},{title:"",content:"|---|---|---|"},{title:"",content:"| 1 | 1 | Gases, wind, and fog can't pass through the barrier."},{title:"",content:"| 2 | 2 | Nonliving matter can't pass through the barrier. Walls, floors, and ceilings can pass through at your discretion."},{title:"",content:"| 3 | 3 | Living matter can't pass through the barrier."},{title:"",content:"| 4 | 4 | Spell effects can't pass through the barrier."},{title:"",content:"| 5 | 5 | Nothing can pass through the barrier. Walls, floors, and ceilings can pass through at your discretion."},{title:"",content:"| 6 | 0 | The barrier deactivates."},{title:"",content:"The cube loses charges when the barrier is targeted by certain spells or comes into contact with certain spell or magic item effects, as shown in the table below."},{title:"",content:"| Spell or Item | Charges Lost |"},{title:"",content:"|---|---|"},{title:"",content:"| Disintegrate | 1d12 |"},{title:"",content:"| Horn of blasting | 1d10 |"},{title:"",content:"| Passwall | 1d6 |"},{title:"",content:"| Prismatic spray | 1d20 |"},{title:"",content:"| Wall of fire | 1d4 |"}]}]}