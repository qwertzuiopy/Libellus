{id:"api-2014-magic-items-deck-of-illusions",name:"Deck of Illusions",content:[{id:"Title",content:"Deck of Illusions"},{id:"StatGrid",content:[{title:"Category",content:"Wondrous Items"},{title:"Rarity",content:"Uncommon"}]},{id:"TitledText",content:[{title:"",content:"Wondrous item, uncommon"},{title:"",content:"This box contains a set of parchment cards. A full deck has 34 cards. A deck found as treasure is usually missing 1d20 - 1 cards."},{title:"",content:"The magic of the deck functions only if cards are drawn at random (you can use an altered deck of playing cards to simulate the deck). You can use an action to draw a card at random from the deck and throw it to the ground at a point within 30 feet of you."},{title:"",content:"An illusion of one or more creatures forms over the thrown card and remains until dispelled. An illusory creature appears real, of the appropriate size, and behaves as if it were a real creature except that it can do no harm. While you are within 120 feet of the illusory creature and can see it, you can use an action to move it magically anywhere within 30 feet of its card. Any physical interaction with the illusory creature reveals it to be an illusion, because objects pass through it. Someone who uses an action to visually inspect the creature identifies it as illusory with a successful DC 15 Intelligence (Investigation) check. The creature then appears translucent."},{title:"",content:"The illusion lasts until its card is moved or the illusion is dispelled. When the illusion ends, the image on its card disappears, and that card can't be used again."},{title:"",content:"| Playing Card | Illusion |"},{title:"",content:"|---|---|"},{title:"",content:"| Ace of hearts | Red dragon |"},{title:"",content:"| King of hearts | Knight and four guards |"},{title:"",content:"| Queen of hearts | Succubus or incubus |"},{title:"",content:"| Jack of hearts | Druid |"},{title:"",content:"| Ten of hearts | Cloud giant |"},{title:"",content:"| Nine of hearts | Ettin |"},{title:"",content:"| Eight of hearts | Bugbear |"},{title:"",content:"| Two of hearts | Goblin |"},{title:"",content:"| Ace of diamonds | Beholder |"},{title:"",content:"| King of diamonds | Archmage and mage apprentice |"},{title:"",content:"| Queen of diamonds | Night hag |"},{title:"",content:"| Jack of diamonds | Assassin |"},{title:"",content:"| Ten of diamonds | Fire giant |"},{title:"",content:"| Nine of diamonds | Ogre mage |"},{title:"",content:"| Eight of diamonds | Gnoll |"},{title:"",content:"| Two of diamonds | Kobold |"},{title:"",content:"| Ace of spades | Lich |"},{title:"",content:"| King of spades | Priest and two acolytes |"},{title:"",content:"| Queen of spades | Medusa |"},{title:"",content:"| Jack of spades | Veteran |"},{title:"",content:"| Ten of spades | Frost giant |"},{title:"",content:"| Nine of spades | Troll |"},{title:"",content:"| Eight of spades | Hobgoblin |"},{title:"",content:"| Two of spades | Goblin |"},{title:"",content:"| Ace of clubs | Iron golem |"},{title:"",content:"| King of clubs | Bandit captain and three bandits |"},{title:"",content:"| Queen of clubs | Erinyes |"},{title:"",content:"| Jack of clubs | Berserker |"},{title:"",content:"| Ten of clubs | Hill giant |"},{title:"",content:"| Nine of clubs | Ogre |"},{title:"",content:"| Eight of clubs | Orc |"},{title:"",content:"| Two of clubs | Kobold |"},{title:"",content:"| Jokers (2) | You (the deck's owner) |"}]}]}