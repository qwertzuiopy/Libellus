{id:"api-2014-magic-items-robe-of-the-archmagi",name:"Robe of the Archmagi",content:[{id:"Title",content:"Robe of the Archmagi"},{id:"StatGrid",content:[{title:"Category",content:"Wondrous Items"},{title:"Rarity",content:"Legendary"}]},{id:"TitledText",content:[{title:"",content:"Wondrous item, legendary (requires attunement by a sorcerer, warlock, or wizard)"},{title:"",content:"This elegant garment is made from exquisite cloth of white, gray, or black and adorned with silvery runes. The robe's color corresponds to the alignment for which the item was created. A white robe was made for good, gray for neutral, and black for evil. You can't attune to a robe of the archmagi that doesn't correspond to your alignment."},{title:"",content:"You gain these benefits while wearing the robe:"},{title:"",content:"If you aren't wearing armor, your base Armor Class is 15 + your Dexterity modifier."},{title:"",content:"You have advantage on saving throws against spells and other magical effects."},{title:"",content:"Your spell save DC and spell attack bonus each increase by 2."}]}]}