{id:"api-2014-features-open-hand-technique",name:"Open Hand Technique",content:[{id:"Title",content:"Open Hand Technique"},{id:"StatGrid",content:[{title:"Level",content:"3"}]},{id:"TitledText",content:[{title:"",content:"Starting when you choose this tradition at 3rd level, you can manipulate your enemy's ki when you harness your own. Whenever you hit a creature with one of the attacks granted by your Flurry of Blows, you can impose one of the following effects on that target:"},{title:"",content:"- It must succeed on a Dexterity saving throw or be knocked prone."},{title:"",content:"- It must make a Strength saving throw. If it fails, you can push it up to 15 feet away from you."},{title:"",content:"- It can't take reactions until the end of your next turn."}]},{id:"LinkList",content:[{id:"@api-2014-classes-monk",content:""},{id:"@api-2014-subclasses-open-hand",content:""}]}]}