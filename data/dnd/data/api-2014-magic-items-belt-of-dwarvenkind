{id:"api-2014-magic-items-belt-of-dwarvenkind",name:"Belt of Dwarvenkind",content:[{id:"Title",content:"Belt of Dwarvenkind"},{id:"StatGrid",content:[{title:"Category",content:"Wondrous Items"},{title:"Rarity",content:"Rare"}]},{id:"TitledText",content:[{title:"",content:"Wondrous Items, rare (requires attunement)"},{title:"",content:"While wearing this belt, you gain the following benefits:"},{title:"",content:"Your Constitution score increases by 2, to a maximum of 20."},{title:"",content:"You have advantage on Charisma (Persuasion) checks made to interact with Dwarves."},{title:"",content:"In addition, while attuned to the belt, you have a 50 percent chance each day at dawn of growing a full beard if you're capable of growing one, or a visibly thicker beard if you already have one."},{title:"",content:"If you aren't a dwarf, you gain the following additional benefits while wearing the belt:"},{title:"",content:"You have advantage on Saving Throws against poison, and you have Resistance against poison damage."},{title:"",content:"You can speak, read, and write Dwarvish."}]}]}