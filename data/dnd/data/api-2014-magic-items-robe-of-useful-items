{id:"api-2014-magic-items-robe-of-useful-items",name:"Robe of Useful Items",content:[{id:"Title",content:"Robe of Useful Items"},{id:"StatGrid",content:[{title:"Category",content:"Wondrous Items"},{title:"Rarity",content:"Uncommon"}]},{id:"TitledText",content:[{title:"",content:"Wondrous item, uncommon"},{title:"",content:"This robe has cloth patches of various shapes and colors covering it. While wearing the robe, you can use an action to detach one of the patches, causing it to become the object or creature it represents. Once the last patch is removed, the robe becomes an ordinary garment."},{title:"",content:"The robe has two of each of the following patches:"},{title:"",content:"Dagger"},{title:"",content:"Bullseye lantern (filled and lit)"},{title:"",content:"Steel mirror"},{title:"",content:"10-foot pole"},{title:"",content:"Hempen rope (50 feet, coiled)"},{title:"",content:"Sack"},{title:"",content:"In addition, the robe has 4d4 other patches. The GM chooses the patches or determines them randomly."},{title:"",content:"| d100 | Patch |"},{title:"",content:"|---|---|"},{title:"",content:"| 01-08 | Bag of 100 gp |"},{title:"",content:"| 09-15 | Silver coffer (1 foot long, 6 inches wide and deep) worth 500 gp |"},{title:"",content:"| 16-22 | Iron door (up to 10 feet wide and 10 feet high, barred on one side of your choice), which you can place in an opening you can reach; it conforms to fit the opening, attaching and hinging itself |"},{title:"",content:"| 23-30 | 10 gems worth 100 gp each |"},{title:"",content:"| 31-44 | Wooden ladder (24 feet long) 45-51 A riding horse with saddle bags |"},{title:"",content:"| 52-59 | Pit (a cube 10 feet on a side), which you can place on the ground within 10 feet of you |"},{title:"",content:"| 60-68 | 4 potions of healing |"},{title:"",content:"| 69-75 | Rowboat (12 feet long) |"},{title:"",content:"| 76-83 | Spell scroll containing one spell of 1st to 3rd level |"},{title:"",content:"| 84-90 | 2 mastiffs |"},{title:"",content:"| 91-96 | Window (2 feet by 4 feet, up to 2 feet deep), which you can place on a vertical surface you can reach |"},{title:"",content:"| 97-100 | Portable ram |"}]}]}