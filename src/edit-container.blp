using Gtk 4.0;
using Adw 1;

template $LibellusEditContainer : Gtk.Box {
  spacing: 6;
  halign: fill;
  Gtk.Image {
    icon-name: "draggable";
    accessibility {
      label: "dragg area";
    }
  }
  Gtk.Button {
    icon-name: "user-trash-symbolic";
    valign: center;
    accessibility {
      label: "delete";
    }
    styles [
      "destructive-action"
    ]
  }
  Gtk.Separator {
    orientation: horizontal;
    margin-end: 6;
  }
}