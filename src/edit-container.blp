using Gtk 4.0;
using Adw 1;

template $LibellusEditContainer : Gtk.ListBoxRow {
  selectable: false;
  activatable: false;
  Gtk.Box box {
    spacing: 6;
    margin-end: 6;
    halign: fill;
    Gtk.Box drag_target {
      orientation: horizontal;
      valign: fill;
      Gtk.Image {
        valign: center;
        icon-name: "draggable";
        accessibility {
          label: "dragg area";
        }
      }
      Gtk.Button {
        icon-name: "user-trash-symbolic";
        valign: center;
        accessibility {
          label: "delete";
        }
        styles [
          "destructive-action"
        ]
      }
    }
    Gtk.Separator {
      orientation: horizontal;
      margin-end: 6;
    }
  }
}